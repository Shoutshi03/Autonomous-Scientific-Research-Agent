# Application settings
APP_TITLE="Scientific Research RAG Agent"
DEBUG=false
MAX_FILE_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIEVED_DOCS=5

# LLM configuration
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-chat
LLM_TEMPERATURE=0

# OpenRouter API key
OPENROUTER_API_KEY=your_api_key_here

# Optional: allow FAISS deserialization only if you trust the local index
ALLOW_DANGEROUS_DESERIALIZATION=false
